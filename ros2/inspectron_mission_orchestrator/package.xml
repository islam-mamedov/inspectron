<?xml version="1.0"?>
<package format="3">
  <name>inspectron_mission_orchestrator</name>
  <version>0.1.0</version>
  <description>
    Fail-closed ROS 2 mission orchestration for Inspectron.
  </description>

  <maintainer email="203401856+islam-mamedov@users.noreply.github.com">
    Islam Mamedov
  </maintainer>

  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>inspectron_mission_msgs</depend>
  <depend>inspectron_safety_supervisor</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
